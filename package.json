{
  "name": "cloudstorm",
  "version": "0.19.0",
  "description": "Minimalistic Discord Gateway library",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "discord",
    "api",
    "gateway",
    "ws",
    "microservice",
    "discord bot",
    "discord bot microservice",
    "microservice bot"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:src": "tsc -p .",
    "build:docs": "typedoc --name CloudStorm --excludeExternals --sort static-first --sort alphabetical",
    "build": "npm run build:src && npm run build:docs",
    "lint": "eslint .",
    "test": "npm run build:src && node --test --test-timeout=30000 --test-force-exit \"test/**/*.test.js\"",
    "test:live": "npm run build:src && node --test --test-timeout=90000 --test-force-exit test/live.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DasWolke/CloudStorm.git"
  },
  "bugs": "https://github.com/DasWolke/CloudStorm/issues",
  "author": "wolke <wolke@weeb.sh>",
  "license": "MIT",
  "dependencies": {
    "discord-api-types": "^0.38.49",
    "snowtransfer": "^0.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ]
}
